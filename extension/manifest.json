{
  "manifest_version": 3,
  "name": "D Collector",
  "version": "2.0.0",
  "description": "表示中の日別ページからジャグラーデータを保存し、公開データへ同期します。",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://ana-slo.com/*",
    "https://www.ana-slo.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "D Collector を開く"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://ana-slo.com/*", "https://www.ana-slo.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
